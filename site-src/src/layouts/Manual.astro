---
import Base from './Base.astro';
import '../styles/manual.css';

interface Props {
  titulo: string;
  descricao: string;
  /** id do capitulo atual (nome do arquivo .md, sem extensao) */
  atual?: string;
  /** [{ id, titulo }] em ordem de leitura */
  capitulos: { id: string; titulo: string }[];
  /** path relativo dentro de /Transcritorio/, ex. 'pt/manual/estudio/' */
  path: string;
}

const { titulo, descricao, atual, capitulos, path } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/pt/`;
const url = (id: string) => `${base}/pt/manual/${id}/`;

const i = capitulos.findIndex((c) => c.id === atual);
const anterior = i > 0 ? capitulos[i - 1] : null;
const proximo = i >= 0 && i < capitulos.length - 1 ? capitulos[i + 1] : null;
---

<Base
  lang="pt"
  title={titulo === 'Manual do Transcritório' ? titulo : `${titulo} — Manual do Transcritório`}
  description={descricao}
  path={path}
  homeHref={home}
  otherHref={`${base}/en/`}
>
  <div class="container manual-shell">
    <aside class="manual-indice">
      <h2>Manual</h2>
      <ol>
        <li>
          <a href={`${base}/pt/manual/`} aria-current={atual ? undefined : 'page'}>Início</a>
        </li>
        {capitulos.map((c) => (
          <li>
            <a href={url(c.id)} aria-current={c.id === atual ? 'page' : undefined}>{c.titulo}</a>
          </li>
        ))}
      </ol>
    </aside>

    <article class="manual-corpo">
      <header>
        <h1>{titulo}</h1>
        <p class="subtitulo">{descricao}</p>
      </header>
      <div class="prosa">
        <slot />
      </div>
      {(anterior || proximo) && (
        <nav class="manual-pes" aria-label="Capítulos">
          {anterior && (
            <a href={url(anterior.id)}>
              <span class="rotulo">Anterior</span>
              {anterior.titulo}
            </a>
          )}
          {proximo && (
            <a class="proximo" href={url(proximo.id)}>
              <span class="rotulo">Próximo</span>
              {proximo.titulo}
            </a>
          )}
        </nav>
      )}
    </article>
  </div>
</Base>
